{
    "name": "atlas-setup",
    "version": "2.0.0",
    "private": true,
    "description": "Centralized setup and dependency management for ATLAS v2.0",
    "scripts": {
        "dev": "vite --config Setup/configs/vite.web.ts",
        "build:web": "vite build --config Setup/configs/vite.web.ts",
        "typecheck": "tsc -p Setup/configs/tsconfig.base.json --noEmit --incremental",
        "lint": "eslint src/apps/web/src src/packages/shared/src --config Setup/configs/.eslintrc.json --cache",
        "audit:security": "npm run scan:secrets",
        "scan:secrets": "echo 'Scanning for secrets...'"
    },
    "dependencies": {
        "firebase": "^10.14.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "postcss": "^8.4.35",
        "prettier": "^3.2.5",
        "react-router": "^7.13.1",
        "react-router-dom": "^7.13.1",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.1.4"
    }
}
