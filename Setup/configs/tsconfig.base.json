{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ESNext"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "incremental": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "tsBuildInfoFile": "../dist/.tsbuildinfo",
        "baseUrl": ".",
        "typeRoots": [
            "../node_modules/@types",
            "../node_modules"
        ],
        "types": [
            "react",
            "react-dom"
        ],
        "paths": {
            "@/*": [
                "../../src/apps/web/src/*"
            ],
            "@atlas/shared": [
                "../../src/packages/shared/src/index.ts"
            ],
            "@atlas/shared/*": [
                "../../src/packages/shared/src/*"
            ]
        }
    },
    "include": [
        "../../src/apps/web/src/**/*.ts",
        "../../src/apps/web/src/**/*.tsx",
        "../../src/packages/shared/src/**/*.ts",
        "../../src/apps/web/src/vite-env.d.ts"
    ]
}